{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dental-portal-backend",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "containers": [
    {
      "class_name": "Backend",
      "image": "./Dockerfile",
      "max_instances": 1,
      "instance_type": {
        "vcpu": 1,
        "memory_mib": 1024,
        "disk_mb": 2000
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "Backend",
        "name": "BACKEND"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Backend"]
    }
  ]
}
