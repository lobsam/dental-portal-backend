APP_NAME="Dental Portal API"
APP_VERSION="0.1.0"
DEBUG=false

DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/dental_portal

JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_MINUTES=43200

# SMTP (used for password-reset emails, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME="Dental Portal"

# Base URL of the deployed frontend, used to build links in emails
FRONTEND_URL=http://localhost:5173

# Password reset token lifetime
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
